generator client {
  provider      = "prisma-client"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Image {
  id           String   @id @default(uuid()) @db.Uuid
  src          String
  alt          String
  width        Int      @default(550)
  height       Int      @default(384)
  order        Int      @default(0)
  priority     Boolean  @default(false)
  imageOffsetX Float    @default(50) @map("image_offset_x")
  imageOffsetY Float    @default(50) @map("image_offset_y")
  // 'manual' = 后台手动上传；'icloud' = 从 iCloud 共享相簿自动同步来的
  source       String   @default("manual")
  // iCloud 照片的 photoGuid，用来判断哪些已经同步过、哪些被从相簿里删了
  externalId   String?  @unique @map("external_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("images")
}

model Track {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  subtitle  String
  src       String
  cover         String?
  lyricsOffset  Float    @default(0) @map("lyrics_offset")
  order         Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("tracks")
}

model Project {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String
  image        String?
  link         String?
  category     String   @default("personal")
  cropX        Float?   @default(50) @map("crop_x")
  cropY        Float?   @default(50) @map("crop_y")
  cropSize     Float?   @default(100) @map("crop_size")
  imageOffsetX Float?   @default(0) @map("image_offset_x")
  imageOffsetY Float?   @default(0) @map("image_offset_y")
  scale        Float?   @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  order        Int      @default(0)
  // 置顶：置顶的项目排在最前面（多个置顶之间仍按 order 排）
  pinned       Boolean  @default(false)

  @@index([order])
  @@map("projects")
}

model Comment {
  id        String            @id @default(uuid()) @db.Uuid
  text      String
  name      String?
  emoji     String?
  likes     Int               @default(0)
  fires     Int               @default(0)
  hearts    Int               @default(0)
  laughs    Int               @default(0)
  wows      Int               @default(0)
  pinned    Boolean           @default(false)
  hidden     Boolean          @default(false) // 自动过滤判定可疑时先隐藏，后台放行后才显示
  flagReason String?          @map("flag_reason") // 被隐藏的原因（规则命中 / AI 判断）
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  reactions CommentReaction[]

  @@index([pinned, createdAt])
  @@map("comments")
}

model CommentReaction {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id")
  type      String
  createdAt DateTime @default(now()) @map("created_at")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, type])
  @@index([commentId])
  @@map("comment_reactions")
}

model ViewCount {
  id          String   @id @default("main")
  count       Int      @default(0)
  lastUpdated DateTime @default(now()) @updatedAt @map("last_updated")

  @@map("view_count")
}

model CountryVisit {
  id          String   @id @default(uuid()) @db.Uuid
  country     String   @unique
  count       Int      @default(0)
  lastUpdated DateTime @default(now()) @updatedAt @map("last_updated")
  lastVisit   DateTime @default(now()) @map("last_visit")

  @@index([country])
  @@map("country_visits")
}

model AdminStatus {
  id         String   @id @default("admin")
  lastActive DateTime @default(now()) @updatedAt @map("last_active")

  @@map("admin_status")
}

model AnniversarySettings {
  id               String   @id
  background_image String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  backgroundImages Json?    @default("[]") @map("background_images")
  image_offset_x   Float?   @default(50)
  image_offset_y   Float?   @default(50)
  imagePositions   Json?    @default("{}") @map("image_positions")

  @@map("anniversary_settings")
}

model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id")
  conversationId String   @default("default") @map("conversation_id")
  role           String   // 'user' | 'assistant'
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, conversationId, createdAt])
  @@map("chat_messages")
}

// /api/chat 限流记录：每次请求一行，只存 IP 的哈希，定期清理
model ChatUsage {
  id        String   @id @default(uuid()) @db.Uuid
  ipHash    String   @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ipHash, createdAt])
  @@index([createdAt])
  @@map("chat_usage")
}

model Guestbook {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  message   String
  emoji     String   @default("👋")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("guestbook")
}

// 首页的社交媒体链接，在后台 Social Links 里编辑
model SocialLink {
  id        String   @id @default(uuid()) @db.Uuid
  platform  String   // 图标，对应 lib/social-platforms.ts 里的 key
  name      String   // 悬停时显示的名字
  url       String
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("social_links")
}

model TechStackItem {
  id        String   @id @default(uuid()) @db.Uuid
  icon      String   // 图标，对应 lib/tech-icons.ts 里的 key
  name      String   // 图标下面显示的名字
  category  String   @default("") // 首页按分类分组显示，同名的放在一组
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("tech_stack")
}

// 定时任务（Vercel Cron）每次运行的记录，后台月报里会汇总
model CronRun {
  id     String   @id @default(uuid()) @db.Uuid
  job    String   // 'storage-cleanup' | 'monthly-report'
  ok     Boolean  @default(true)
  result Json     @default("{}")
  ranAt  DateTime @default(now()) @map("ran_at")

  @@index([job, ranAt])
  @@map("cron_runs")
}

// 每月 1 号生成的月报快照；累计数据（访问量、各国访问）要靠上个月的快照算出当月增量
model MonthlyReport {
  id        String   @id @default(uuid()) @db.Uuid
  month     String   @unique // 'YYYY-MM'，报告所属的月份
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("monthly_reports")
}

// 接到网站上的 iCloud 共享相簿（每天自动同步一次）
// id: 'snapshots'（首页照片区）| 'anniversary'（纪念日轮播）
model AlbumSource {
  id           String    @id
  shareUrl     String    @map("share_url")
  albumName    String?   @map("album_name")
  enabled      Boolean   @default(true)
  // anniversary: { map: { guid: url } }；两边都有 excluded: 在后台手动删掉、不要再同步回来的 guid
  items        Json      @default("{}")
  lastSyncedAt DateTime? @map("last_synced_at")
  lastResult   Json      @default("{}") @map("last_result")
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("album_sources")
}
